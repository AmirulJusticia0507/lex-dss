# Lex-DSS Frontend Environment Variables
# Copy to .env.local for local dev, or set in Vercel dashboard for production

# API Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_NAME=Lex-DSS
VITE_APP_VERSION=1.0.0

# Feature Flags
VITE_ENABLE_MOCK_DATA=false
VITE_ENABLE_ANALYTICS=false

# CAPTCHA
# Set "false" to hide captcha UI (when backend CAPTCHA_ENABLED=False)
VITE_CAPTCHA_ENABLED=true

# Theme
VITE_DEFAULT_THEME=light

# Vercel-specific (auto-populated in Vercel dashboard)
# VITE_VERCEL_ENV=production
# VITE_VERCEL_URL=https://lex-dss.vercel.app