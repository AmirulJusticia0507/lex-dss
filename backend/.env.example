# Salin ke backend/.env lalu isi nilai sebenarnya. JANGAN commit file .env.

APP_NAME=Lex-DSS
APP_VERSION=0.1.0
DEBUG=True
API_V1_STR=/api/v1

# ===========================================
# DATABASE CONFIGURATION
# ===========================================

# --- LOCAL DEVELOPMENT (Docker Compose) ---
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lex_dss
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lex_dss

# --- PRODUCTION (Neon PostgreSQL) ---
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DATABASE

# ===========================================
# SECURITY
# ===========================================
SECRET_KEY=ganti-dengan-random-secret-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ===========================================
# LLM PROVIDER - Ollama (Primary) + Gemini (Fallback)
# Models from lex-integrity project
# ===========================================
# Ollama (local/self-hosted)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=deepseek-r1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_AGENT_MODEL=lex-integrity-agent:latest
OLLAMA_TIMEOUT=120

# Gemini (cloud fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=models/embedding-001
GEMINI_TIMEOUT=60

# ===========================================
# LLM SETTINGS
# ===========================================
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_SYSTEM_PROMPT="Anda adalah asisten hukum Indonesia expert. Berikan analisis hukum yang akurat, mendalam, dan berbasis regulasi Indonesia yang berlaku (UU, Peraturan Pemerintah, Peraturan Presiden, Peraturan Menteri, Perda, KUHP, KUHPerdata, KUHAP, dsb). Gunakan metodologi Lex Integrity: cek hierarki (Lex Superior, Lex Specialis, Lex Posterior), deteksi kontradiksi langsung, dan analisis domain hukum (Pidana/Anatomie Van Delict, Perdata/Pasal 1320/1337 KUHPerdata). Jawab dalam Bahasa Indonesia formal hukum. Format output: JSON valid jika diminta. Selalu sertakan dasar hukum (pasal/ayat), ratio decidendi, dan rekomendasi konkret."

# ===========================================
# EMBEDDING (via Ollama)
# ===========================================
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768

# ===========================================
# CACHE / QUEUE
# ===========================================
REDIS_URL=redis://localhost:6379/0

# Internal integration with lex-integrity
LEX_INTEGRITY_URL=http://localhost:3000
INTERNAL_API_KEY=generate-a-long-random-shared-key

# E-Netizen civic polling (e-voting-system-netizen).
# ENETIZEN_HMAC_SECRET must equal LEX_DSS_HMAC_SECRET in the e-voting backend.
ENETIZEN_URL=http://localhost:8000
ENETIZEN_HMAC_SECRET=

# Batch STT for moderator-uploaded civic meeting audio/video.
STT_API_KEY=
STT_API_BASE=https://api.openai.com/v1
STT_MODEL=whisper-1
STT_MAX_UPLOAD_MB=25

# ===========================================
# EXTERNAL DATA INTEGRATIONS
# Fill only after a formal access agreement is approved. Do not commit secrets.
# ===========================================
SIPP_API_BASE_URL=
SIPP_API_KEY=
JDIHN_API_BASE_URL=
JDIHN_API_KEY=
OSS_API_BASE_URL=
OSS_API_CLIENT_ID=
OSS_API_CLIENT_SECRET=
DJP_API_BASE_URL=
DJP_API_CLIENT_ID=
DJP_API_CLIENT_SECRET=
KEMENPERIN_API_BASE_URL=
KEMENPERIN_API_KEY=
DPR_API_BASE_URL=
DPR_API_KEY=

# ===========================================
# CAPTCHA (multi-provider: hcaptcha | math | none)
# ===========================================
# hCaptcha (privacy-focused, drop-in replacement for reCAPTCHA)
# Dapat diakses di https://hcaptcha.com/
HCAPTCHA_SITE_KEY=your-hcaptcha-site-key
HCAPTCHA_SECRET_KEY=your-hcaptcha-secret-key

# CAPTCHA_PROVIDER: "hcaptcha" | "math" | "none"
CAPTCHA_PROVIDER=none  # Set "hcaptcha" or "math" di production
CAPTCHA_ENABLED=False
CAPTCHA_THRESHOLD=0.5  # Score threshold (hCaptcha)

# ===========================================
# OPTIONAL: Sentry / Monitoring
# ===========================================
# SENTRY_DSN=
