# Salin ke backend/.env lalu isi nilai sebenarnya. JANGAN commit file .env.

APP_NAME=Lex-DSS
APP_VERSION=0.1.0
DEBUG=True
API_V1_STR=/api/v1

# ===========================================
# DATABASE CONFIGURATION
# ===========================================

# --- LOCAL DEVELOPMENT (Docker Compose) ---
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lex_dss
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lex_dss

# --- PRODUCTION (Neon PostgreSQL) ---
# DATABASE_URL=postgresql+asyncpg://neondb_owner:npg_IfWBbCGaL8O2@ep-polished-unit-b51c91ak-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ===========================================
# SECURITY
# ===========================================
SECRET_KEY=ganti-dengan-random-secret-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ===========================================
# LLM PROVIDER (OpenAI-compatible)
# ===========================================
LLM_PROVIDER=bazaarlink
OPENAI_API_BASE=https://api.bazaarlink.ai/v1
OPENAI_API_KEY=
LLM_MODEL=auto:free
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=120

# ===========================================
# EMBEDDING
# ===========================================
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# ===========================================
# CACHE / QUEUE
# ===========================================
REDIS_URL=redis://localhost:6379/0